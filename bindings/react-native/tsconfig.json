{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "lib",
    "rootDir": "."
  },
  "include": [
    "turbo/**/*.ts",
    "src/**/*.ts",
    "test/**/*.ts",
    "types/*.d.ts"
  ],
  "exclude": [
    "lib",
    "node_modules"
  ]
}
